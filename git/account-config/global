#------------------------------------------------------------------------------
#-----  Global Git Configuration

[color]
    ui = auto
[core]
    editor = nvim
	excludesfile = /home/holze/.gitignore_global
[diff]
    tool = vimdiff
[fetch]
    prune = true
[help]
    autocorrect = 10
[pull]
    rebase = false
[init]
    defaultBranch = main
[push]
    default = current
[rerere]
    enabled = true
[safe]
    directory = /var/www/html
[user]
	email = holzerdaniel01@gmail.com
	name = DaniHolzer



#------------------------------------------------------------------------------
#-----  Repository Specific Configuration

# Personal GitHub:
[includeIf "gitdir:~/personal/github/"]
    path = ~/dotfiles/git/account-config/personal/github

# Personal GitLab:
[includeIf "gitdir:~/personal/gitlab/"]
    path = ~/dotfiles/git/account-config/personal/gitlab

# dotfiles:
[includeIf "gitdir:~/dotfiles/"]
    path = ~/dotfiles/git/account-config/personal/github

# ansible:
[includeIf "gitdir:~/ansible/"]
    path = ~/dotfiles/git/account-config/personal/github

# Work fitcrew GitHub:
[includeIf "gitdir:~/work/github/"]
    path = ~/dotfiles/git/account-config/work/github

# Work fitcrew GitLab:
[includeIf "gitdir:~/work/gitlab/"]
    path = ~/dotfiles/git/account-config/work/gitlab
