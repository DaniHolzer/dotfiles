;; KMonad configuration for window management layer switching
;; Hold 'a' or ';' to access window switching layer with numbers

(defcfg
  input  (device-file "/dev/input/event4")
  output (uinput-sink "KMonad output")
  cmp-seq ralt
  cmp-seq-delay 5
  fallthrough true
  allow-cmd false
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet menu rctl
)

(defalias
  ;; Layer switching aliases
  ;; Hold 'a' for window management layer
  a_win (tap-hold-next-release 200 a (layer-toggle windowm))
  ;; Hold ';' for window management layer
  sc_win (tap-hold-next-release 200 ; (layer-toggle windowm))

  ;; LT(4,KC_D) = tap D, hold for layer 4 (vim/tmux)
  d_tmux (tap-hold-next-release 200 d (layer-toggle tmux))
  k_tmux (tap-hold-next-release 200 k (layer-toggle tmux))

  ;; windowm
    ;; Window switching shortcuts (i3wm style)
    ;; These will send Ctrl+Super+Alt+number for workspace switching
    win1 C-M-A-1
    win2 C-M-A-2
    win3 C-M-A-3
    win4 C-M-A-4
    win5 C-M-A-5
    win6 C-M-A-6
    win7 C-M-A-7
    win8 C-M-A-8
    win9 C-M-A-9
    win0 C-M-A-0

    ;; Kill current window
    kwin C-w

    ;; Fuzzy finder
    fzf C-f

    ;; Window movement between workspaces (Alt+Cmd+hjkl)
    winr A-M-h
    winl A-M-l
    winu A-M-k
    wind A-M-j
    ;; Window focus and movement (Alt+Shift+hjkl)
    focH A-S-h
    focJ A-S-j
    focK A-S-k
    focL A-S-l


  ;; Vim/Tmux layer (Layer 4) - Common tmux shortcuts
  ;; These are placeholder - adjust to match your actual tmux prefix
tmx1 (send-keys C-b 1))
)


;; Base layer - normal QWERTY with layer switching keys
(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps @a_win s    @d_tmux    f    g    h    j    @k_tmux    l    @sc_win '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet menu rctl
)

;; Window management layer - activated by holding 'a' or ';'
(deflayer windowm
  @kwin @win1 @win2 @win3 @win4 @win5 @win6 @win7 @win8 @win9 @win0 _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    @fzf    _    @winr @wind @winu @winl    _    _    _
  _    _    _    _    _    _    @focH @focJ @focK @focL     _    _
  _    _    _              _              _    _    _    _
)

;; Tmux layer - activated by holding 'a' or ';'
(deflayer windowm
  @kwin @win1 @win2 @win3 @win4 @win5 @win6 @win7 @win8 @win9 @win0 _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    @fzf    _    @winr @wind @winu @winl    _    _    _
  _    _    _    _    _    _    @focH @focJ @focK @focL     _    _
  _    _    _              _              _    _    _    _
)

;; Layer 4 - Tmux commands (accessed by holding D or K)
(deflayer tmux
  _    @tmx1 @tmx2 @tmx3 @tmx4 @tmx5 @tmx6 @tmx7 @tmx8 @tmx9 @tmx0 _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    @fzf    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _    _
)
